# Environment Variables - CrustCraft Server
# Copy this file to .env and fill in your values
# NEVER commit .env to git.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (leave empty to use persistent file-backed MongoMemoryServer)
MONGODB_URI=

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Admin Seed Account
ADMIN_NAME=CrustCraft Admin
ADMIN_EMAIL=admin@crustcraft.com
ADMIN_PASSWORD=Admin@123456

# Razorpay TEST Mode
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# -----------------------------------------------------------------------
# Email — Gmail SMTP
# -----------------------------------------------------------------------
# Step 1: Enable 2-Step Verification on your Google account.
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password for "Mail" → "Other (Custom name)" → name it CrustCraft
# Step 4: Copy the 16-character password (spaces are ignored) into SMTP_PASSWORD below.
# DO NOT use your normal Gmail login password here.
# -----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SMTP_FROM=you@gmail.com
ADMIN_NOTIFICATION_EMAIL=you@gmail.com

# Frontend URL (used to build verification/reset links in emails)
CLIENT_URL=http://localhost:5173
